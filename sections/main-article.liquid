{{ 'component-rte.css' | asset_url | stylesheet_tag }}
{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'copy.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{%- endstyle -%}

{% assign block_header = section.blocks[0] %}
<article
  class="article-template {% if block_header.settings.header_variant == 'overlay' %} section--has-overlay article-template--overlay {% endif %}"
  itemscope
  itemtype="http://schema.org/BlogPosting"
>
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div
          class="container page-width--narrow"
          {{ block.shopify_attributes }}
        >
          {% render block %}
        </div>
      {%- when 'article-header' -%}
        {% liquid
          case block.settings.header_variant
            when 'column'
              assign header_class = 'article-template__header--column'
              assign style_class = '.article-template__img'
              assign wrapper_class = ''
              assign info_class = ''
            when 'overlay'
              assign header_class = 'article-template__header--overlay '
              assign style_class = '.article-template__info-wrapper'
              assign wrapper_class = 'have-overlay color-inverse'
              assign info_class = 'section-' | append: section.id | append: '-padding container-small'
            else
              assign header_class = 'article-template__header--column'
              assign style_class = '.article-template__img'
              assign wrapper_class = ''
              assign info_class = ''
          endcase
          case block.settings.image_size
            when 'adapt'
              assign section_size = 0
            when 'large'
              assign section_size = 'calc(100vh - var(--header-height))'
            else
              assign section_size = block.settings.image_size
          endcase
          assign image_height = article.image.width | divided_by: article.image.aspect_ratio
          assign adapt_height = 1 | divided_by: article.image.aspect_ratio | times: 100 | append: '%'
          if block.settings.image_size == 'adapt'
            assign section_size = adapt_height
          endif
        %}
        {% style %}
          #shopify-section-{{ section.id }} {{ style_class }} {
          	{% if block.settings.image_size == 'adapt' or block.settings.image_size == 'large' %}
          		--image-height : {{ section_size }};
          	{% else %}
          		aspect-ratio: {{ section_size }};
          	{% endif %}
          }
          #shopify-section-{{ section.id }} .article-template__header .have-overlay {
          	--overlay-alpha : {{ block.settings.overlay_opacity }}%;
          }
        {% endstyle %}
        <header
          class="article-template__header {{ header_class }}"
          {{ block.shopify_attributes }}
        >
          {% liquid
            if block.settings.header_variant == 'overlay' and article.excerpt.size < 1 or block.settings.blog_show_excerpt == false
              assign no_desk = true
            else
              assign no_desk = false
            endif
          %}
          <div class=" container">
            <div class="article-template__wrapper overlay-header-paddings {{ wrapper_class }}">
              <div class="article-template__info-wrapper ">
                <div class="article-template__info {{ info_class }}">
                  <div class="article-template__text{% if no_desk %} article-template__item{% endif %}">
                    <{{ block.settings.heading_tag }} class="article-template__title h2" itemprop="headline">
                      {{ article.title | escape }}
                    </{{ block.settings.heading_tag }}>
                    {% if no_desk == false and article.excerpt.size > 0 and block.settings.blog_show_excerpt %}
                      <div>
                    {% endif %}

                    {%- if article.excerpt.size > 0 and block.settings.blog_show_excerpt -%}
                      <p class="article-template__excerpt large-font">
                        {{ article.excerpt | strip_html | truncatewords: 30 }}
                      </p>

                      {% if no_desk == false and article.excerpt.size > 0 and block.settings.blog_show_excerpt %}
                        </div>
                      {%- endif -%}
                    {% endif %}
                  </div>
                </div>
              </div>
              <div class="article-template__box">
                {% if settings.show_breadcrumbs %}
                  <nav
                    class="container breadcrumb breadcrumb_margin"
                    role="navigation"
                    aria-label="breadcrumbs"
                  >
                    <a
                      href="{{ routes.root_url }}"
                      title="{{ 'general.breadcrumbs.home' | t }}"
                      class="breadcrumb__link"
                    >
                      <span>{{ 'general.breadcrumbs.home' | t }} </span>
                    </a>
                    <div class="breadcrumb__delimiter">
                      {% render 'icon-breadcrumbs' %}
                    </div>
                    <span
                      ><a
                        href="{{ blog.url }}"
                        title="{{ blog.title }}"
                        class="breadcrumb__link"
                      >
                        {{ blog.title }}
                      </a></span
                    >
                    <div class="breadcrumb__delimiter">
                      {% render 'icon-breadcrumbs' %}
                    </div>
                    <div>{{ article.title }}</div>
                  </nav>
                {% endif %}
                <div class="article-template__img_box">
                  {%- if article.image -%}
                    <div class="article-template__img" data-id="{{ block.id }}">
                      {{
                        article.image
                        | image_url: width: 3840
                        | image_tag:
                          loading: 'lazy',
                          width: article.image.width,
                          height: image_height,
                          sizes: '100vw',
                          widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
                      }}
                    </div>
                  {%- endif -%}
                </div>
                <div class="article-template__box_info">
                  <div class="article-template__meta">
                    <div class="article-template__item">
                      {%- if article.tags != blank and block.settings.blog_show_tags == true -%}
                        <ul class="article-template__tags">
                          {% for tag in article.tags %}
                            <li class="article-template__tag subtitle">
                              <a
                                href="{{ blog.url }}/tagged/{{ tag | handle }}"
                                class="full-unstyled-link"
                                title="{{ tag }}"
                              >
                                {{ tag }}
                              </a>
                            </li>
                          {% endfor %}
                        </ul>
                      {%- endif -%}
                      {%- if block.settings.blog_show_date -%}
                        <span
                          class="article-template__meta-date small-font"
                          itemprop="dateCreated pubdate datePublished"
                        >
                          <span class="small-font"
                            >&nbsp;
                            {{- article.published_at | time_tag: '%B %d, %Y' -}}
                          </span>
                        </span>
                      {%- endif -%}
                      {%- if block.settings.blog_show_author -%}
                        <span
                          class="article-template__meta-author small-font"
                          itemprop="name"
                        >
                          by <span>{{ article.author }}</span>
                        </span>
                      {%- endif -%}
                    </div>
                  </div>

                  {%- if block.settings.show_share_facebook
                    or block.settings.show_share_twitter
                    or block.settings.show_share_pinterest
                    or block.settings.show_share_copy
                  -%}
                    <ul class="share-buttons-simple" role="list">
                      <span class="subtitle">{{ 'general.share.share_article' | t }}</span>
                      {%- if block.settings.show_share_facebook -%}
                        <li class="share-buttons-simple__item">
                          <a
                            href="https://www.facebook.com/sharer.php?u={{ shop.url | append: article.url }}"
                            class="share-buttons-simple__button facebook-btn"
                            target="_blank"
                            aria-label="facebook"
                          >
                            {% render 'icon-facebook' %}
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if block.settings.show_share_twitter -%}
                        <li class="share-buttons-simple__item">
                          <a
                            href="https://twitter.com/share?url={{ shop.url | append: article.url }}&text={{ article.title | escape }}"
                            class="share-buttons-simple__button twitter-btn"
                            target="_blank"
                            aria-label="twitter"
                          >
                            {% render 'icon-twitter' %}
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if block.settings.show_share_pinterest -%}
                        <li class="share-buttons-simple__item">
                          <a
                            href="https://pinterest.com/pin/create/bookmarklet/?media={{ article.image | img_url: '1100x1100' }}&url={{ shop.url | append: article.url }}&description={{ article.title | escape }}"
                            class="share-buttons-simple__button pinterest-btn"
                            target="_blank"
                            aria-label="pinterest"
                          >
                            {% render 'icon-pinterest' %}
                          </a>
                        </li>
                      {%- endif -%}

                      {%- if block.settings.show_share_copy -%}
                        <li class="share-buttons-simple__item copy-wrapper">
                          <a
                            href="{{ shop.url | append: article.url }}"
                            class="share-buttons-simple__button copy-btn"
                            aria-label="copy link"
                          >
                            {% render 'icon-copy' %}
                          </a>
                          <div id="tooltip" class="tooltip">{{ 'general.share.success_message' | t }}</div>
                        </li>
                      {%- endif -%}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        </header>

      {%- when 'content' -%}
        <div class="container">
          <div class="article-template__content-box">
            <div
              class="article-template__content rte{%if settings.rte_type == 'custom'%} rte__container{% endif %} article-template__content-{{ block.settings.content_layout }}"
              itemprop="articleBody"
              {{ block.shopify_attributes }}
            >
              {{ article.content }}
            </div>
          </div>
        </div>
      {%- when 'article-footer' -%}
        <div class="container">
          <div class="article-template__footer">
            <div class="article-template__footer-content ">
              {%- if block.settings.blog_show_author
                or block.settings.blog_show_date
                or block.settings.blog_show_tags
              -%}
                <div class="article-template__meta article-template__meta-date">
                  <div class="article-template__item">
                    {%- if article.tags != blank and block.settings.blog_show_tags == true -%}
                      <ul class="article-template__tags">
                        {% for tag in article.tags %}
                          <li class="article-template__tag subtitle">
                            <a
                              href="{{ blog.url }}/tagged/{{ tag | handle }}"
                              class="full-unstyled-link"
                              title="{{ tag }}"
                            >
                              {{ tag }}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    {%- endif -%}

                    {%- if block.settings.blog_show_date -%}
                      <span
                        class="article-template__meta-date "
                        itemprop="dateCreated pubdate datePublished"
                      >
                        <span
                          class="small-font"
                          >&nbsp;
                          {{- article.published_at | time_tag: '%B %d, %Y' -}}
                        </span></span
                      >
                    {%- endif -%}
                    {%- if block.settings.blog_show_author -%}
                      <span
                        class="article-template__meta-author small-font"
                        itemprop="name"
                      >
                        by <span>{{ article.author }}</span>
                      </span>
                    {%- endif -%}
                    {% comment %}
                      {%- if article.tags != blank
                      	and block.settings.blog_show_tags == true
                      -%}
                      	<ul class="article-template__tags">
                      		{% for tag in article.tags %}
                      			<li class="article-template__tag">
                      				<a
                      					href="{{ blog.url }}/tagged/{{ tag | handle }}"
                      					class=" full-unstyled-link"
                      					title="{{ tag }}"
                      				>
                      				{{ tag }}
                      					{% render 'icon-caret-right' %}
                      				</a>
                      			</li>
                      		{% endfor %}
                      	</ul>
                      {%- endif -%}
                    {% endcomment %}
                  </div>
                </div>
              {%- endif -%}
              {%- if block.settings.show_share_facebook
                or block.settings.show_share_twitter
                or block.settings.show_share_pinterest
                or block.settings.show_share_copy
              -%}
                <ul class="share-buttons-simple">
                  <span class="subtitle">{{ 'general.share.share_article' | t }}</span>
                  {%- if block.settings.show_share_facebook -%}
                    <li class="share-buttons-simple__item">
                      <a
                        href="https://www.facebook.com/sharer.php?u={{ shop.url | append: article.url }}"
                        class="share-buttons-simple__button facebook-btn"
                        target="_blank"
                        aria-label="facebook"
                      >
                        {% render 'icon-facebook' %}
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_share_twitter -%}
                    <li class="share-buttons-simple__item">
                      <a
                        href="https://twitter.com/share?url={{ shop.url | append: article.url }}&text={{ article.title | escape }}"
                        class="share-buttons-simple__button twitter-btn"
                        target="_blank"
                        aria-label="twitter"
                      >
                        {% render 'icon-twitter' %}
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_share_pinterest -%}
                    <li class="share-buttons-simple__item">
                      <a
                        href="https://pinterest.com/pin/create/bookmarklet/?media={{ article.image | img_url: '1100x1100' }}&url={{ shop.url | append: article.url }}&description={{ article.title | escape }}"
                        class="share-buttons-simple__button pinterest-btn"
                        target="_blank"
                        aria-label="pinterest"
                      >
                        {% render 'icon-pinterest' %}
                      </a>
                    </li>
                  {%- endif -%}

                  {%- if block.settings.show_share_copy -%}
                    <li class="share-buttons-simple__item copy-wrapper">
                      <a
                        href="{{ shop.url | append: article.url }}"
                        class="share-buttons-simple__button copy-btn"
                        aria-label="copy link"
                      >
                        {% render 'icon-copy' %}
                      </a>
                      <div id="tooltip" class="tooltip">{{ 'general.share.success_message' | t }}</div>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        </div>
    {%- endcase -%}
  {%- endfor -%}

  {%- if blog.comments_enabled? -%}
    <div class="article-template__comment-wrapper background-secondary">
      <div id="comments" class="page-width page-width--narrow">
        {%- if article.comments_count > 0 -%}
          {%- assign anchorId = '#Comments-' | append: article.id -%}

          <h2 id="Comments-{{ article.id }}" tabindex="-1">
            {{ 'blogs.article.comments' | t: count: article.comments_count }}
          </h2>
          {% paginate article.comments by 5 %}
            <div class="article-template__comments">
              {%- if comment.status == 'pending' and comment.content -%}
                <article
                  id="{{ comment.id }}"
                  class="article-template__comments-comment"
                >
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">
                      {{- comment.author -}}
                    </span>
                  </footer>
                </article>
              {%- endif -%}

              {%- for comment in article.comments -%}
                <article
                  id="{{ comment.id }}"
                  class="article-template__comments-comment"
                >
                  {{ comment.content }}
                  <footer class="right">
                    <span class="circle-divider caption-with-letter-spacing">
                      {{- comment.author -}}</span
                    ><span class="caption-with-letter-spacing">
                      {{- comment.created_at | time_tag: format: 'date' -}}
                    </span>
                  </footer>
                </article>
              {%- endfor -%}
              {% render 'pagination', paginate: paginate, anchor: anchorId %}
            </div>
          {% endpaginate %}
        {%- endif -%}
        {% form 'new_comment', article %}
          {%- liquid
            assign post_message = 'blogs.article.success'
            if blog.moderated? and comment.status == 'unapproved'
              assign post_message = 'blogs.article.success_moderated'
            endif
          -%}
          <h2>{{ 'blogs.article.comment_form_title' | t }}</h2>
          {%- if form.errors -%}
            <div class="form__message" role="alert">
              <h3
                class="form-status caption-large text-body"
                tabindex="-1"
                autofocus
              >
                {% render 'icon-error' %}
                {{ 'templates.contact.form.error_heading' | t }}
              </h3>
            </div>
            <ul class="form-status-list caption-large">
              {%- for field in form.errors -%}
                <li>
                  <a href="#CommentForm-{{ field }}" class="link">
                    {%- if form.errors.translated_fields[field] contains 'author' -%}
                      {{ 'blogs.article.name' | t }}
                    {%- elsif form.errors.translated_fields[field] contains 'body' -%}
                      {{ 'blogs.article.message' | t }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] }}
                    {%- endif -%}
                    {{ form.errors.messages[field] }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status-list form__message" role="status">
              <h3 class="form-status" tabindex="-1" autofocus>
                {% render 'icon-success' %}
                {{ post_message | t }}
              </h3>
            </div>
          {%- endif -%}

          <div
            {% if blog.moderated? == false %}
              class="article-template__comments-fields"
            {% endif %}
          >
            <div class="article-template__comment-fields">
              <div class="field field--with-error">
                <input
                  type="text"
                  name="comment[author]"
                  id="CommentForm-author"
                  class="field__input"
                  autocomplete="name"
                  dir="ltr"
                  value="{{ form.author }}"
                  aria-required="true"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-author-error"
                  {% endif %}
                  placeholder=" "
                >
                <label class="field__label" for="CommentForm-author">
                  {{- 'blogs.article.name' | t -}}
                </label>
                {%- if form.errors contains 'author' -%}
                  <small id="CommentForm-author-error">
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- 'blogs.article.name' | t }}
                      {{ form.errors.messages.author }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
              <div class="field field--with-error">
                <input
                  type="email"
                  name="comment[email]"
                  id="CommentForm-email"
                  autocomplete="email"
                  class="field__input"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  dir="ltr"
                  aria-required="true"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                    aria-describedby="CommentForm-email-error"
                  {% endif %}
                  placeholder=" "
                >
                <label class="field__label" for="CommentForm-email">
                  {{- 'blogs.article.email' | t -}}
                </label>
                {%- if form.errors contains 'email' -%}
                  <small id="CommentForm-email-error">
                    <span class="form__message">
                      {%- render 'icon-error' -%}
                      {{- 'blogs.article.email' | t }}
                      {{ form.errors.messages.email }}.</span
                    >
                  </small>
                {%- endif -%}
              </div>
            </div>
            <div class="field field--with-error">
              <textarea
                rows="5"
                name="comment[body]"
                id="CommentForm-body"
                class="text-area field__input"
                aria-required="true"
                required
                {% if form.errors contains 'body' %}
                  aria-invalid="true"
                  aria-describedby="CommentForm-body-error"
                {% endif %}
                placeholder=" "
              >{{ form.body }}</textarea>
              <label class="form__label field__label" for="CommentForm-body">
                {{- 'blogs.article.message' | t -}}
              </label>
            </div>
            {%- if form.errors contains 'body' -%}
              <small id="CommentForm-body-error">
                <span class="form__message">
                  {%- render 'icon-error' -%}
                  {{- 'blogs.article.message' | t }}
                  {{ form.errors.messages.body }}.</span
                >
              </small>
            {%- endif -%}
          </div>
          {%- if blog.moderated? -%}
            <p class="article-template__comment-warning caption">
              {{ 'blogs.article.moderated' | t }}
            </p>
          {%- endif -%}
          <button
            type="submit"
            class="button button--primary"
          >
            <span class="button-label">
              <span>{{ 'blogs.article.post' | t }}</span>
            </span>
          </button>
        {% endform %}
      </div>
    </div>
  {%- endif -%}
</article>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Article",
    "articleBody": {{ article.content | strip_html | json }},
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ request.origin | append: page.url | json }}
    },
    "headline": {{ article.title | json }},
    {% if article.excerpt != blank %}
      "description": {{ article.excerpt | strip_html | json }},
    {% endif %}
    {% if article.image %}
  			{% assign image_size = article.image.width | append: 'x' %}
      "image": [
        {{ article | img_url: image_size | prepend: "https:" | json }}
      ],
    {% endif %}
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": {
      "@type": "Person",
      "name": {{ article.author | json }}
    },
    "publisher": {
      "@type": "Organization",
      {% if settings.share_image %}
  				{% assign image_size = settings.share_image.width | append: 'x' %}
        "logo": {
          "@type": "ImageObject",
          "height": {{ settings.share_image.height | json }},
          "url": {{ settings.share_image | img_url: image_size | prepend: "https:" | json }},
          "width": {{ settings.share_image.width | json }}
        },
      {% endif %}
      "name": {{ shop.name | json }}
    }
  }
</script>

{% schema %}
{
  "name": "t:sections.main-article.name",
  "tag": "section",
  "class": "section-main-article",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        }
      ],
