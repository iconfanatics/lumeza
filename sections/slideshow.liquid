{{ 'section-slideshow.css' | asset_url | stylesheet_tag }}
<script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>
{% style %}
  {% render 'section-margin' %}
{% endstyle %}

{% liquid
  assign text_animation = section.settings.text_animation
  assign vertical_alignment = section.settings.vertical_alignment

  assign slide_effects = section.settings.slide_effects
  assign parallax = section.settings.parallax
  assign slideshow_speed = section.settings.slideshow_speed
  assign autoplay = section.settings.is_autoplay
  assign stop_autoplay = section.settings.is_hover_stop_autoplay
  assign slideshow_delay = section.settings.slideshow_delay
  assign image_size = section.settings.image_size
  assign alignment = section.settings.section_alignment

  case image_size
    when 'adapt'
      assign section_size = 0
      assign slide_class = image_size
    when '1/1'
      assign section_size = '100%'
      assign slide_class = image_size
    when '3/2'
      assign section_size = '60%'
      assign slide_class = image_size
    when '4/3'
      assign section_size = '75%'
      assign slide_class = image_size
    when '16/9'
      assign section_size = '56%'
      assign slide_class = image_size
    when '21/9'
      assign section_size = '42.8%'
      assign slide_class = image_size
    when 'large'
      assign section_size = 'calc(100vh - var(--header-height) - var(--announcement-height))'
      assign slide_class = image_size
    else
      assign section_size = 'calc(100vh - var(--header-height) - var(--announcement-height))'
      assign slide_class = image_size
  endcase

  case alignment
    when 'left'
      assign section_style = 'margin : auto auto auto 0; text-align : left;'
    when 'center'
      assign section_style = 'margin : auto; text-align : center;'
    else
      assign section_style = 'auto 0'
  endcase
%}
<div
  class="slideshow {{ slide_class }}"
  data-id="shopify-section-{{ section.id }}"
  data-autoplay="{{ autoplay }}"
  data-stop-autoplay="{{ stop_autoplay }}"
  data-speed="{{ slideshow_speed }}"
  data-delay="{{ slideshow_delay }}"
  data-parallax="{{ parallax }}"
  data-effect="{{ slide_effects }}"
>
  {% if section.settings.section_layout == 'container' %}
    <div class="container ">
  {% endif %}
  <div class="slideshow__swiper swiper{% if section.settings.show_navigation or section.settings.show_pagination %} have-controllers{% endif %}">
    <div class="slideshow__wrapper swiper-wrapper">
      {% for block in section.blocks %}
        {% liquid
          assign image_height = block.settings.image.width | divided_by: block.settings.image.aspect_ratio
          assign adapt_height = 1 | divided_by: block.settings.image.aspect_ratio | times: 100 | append: '%'
          assign slide_color = block.settings.color_scheme
          if image_size == 'adapt'
            assign section_size = adapt_height
          endif

          assign bg_image_calc_ratio_desktop = 1

          if section.settings.image_size != 'adapt' and section.settings.image_size != 'large'
            assign aspect_ratio_desktop = section.settings.image_size | split: '/'
            assign temp = aspect_ratio_desktop[0] | append: '.0'
            assign padding_bottom_desktop = aspect_ratio_desktop[1] | divided_by: temp | times: 100 | round: 2 | append: '%'

            assign aspect_ratio_desktop_value = aspect_ratio_desktop[0] | append: '.0' | divided_by: aspect_ratio_desktop[1]

            if block.settings.image.aspect_ratio > aspect_ratio_desktop_value
              assign bg_image_calc_ratio_desktop = block.settings.image.aspect_ratio | divided_by: aspect_ratio_desktop_value | round: 2
            endif
          elsif section.settings.image_size == 'adapt'
            if block.settings.image != blank
              assign bg_image_calc_ratio_desktop = 1
            endif
          elsif section.settings.image_size == 'large'
            assign bg_image_calc_ratio_desktop = block.settings.image.aspect_ratio | times: 1.77
          endif
        %}

        {% if section.settings.section_layout == 'full' %}
          {% if block.settings.image_second == blank %}
            {%- capture sizes -%}
								calc(100vw * {{ bg_image_calc_ratio_desktop }})
							{%- endcapture -%}
          {% else %}
            {%- capture sizes -%}
								(min-width: 576px) calc(50vw * {{ bg_image_calc_ratio_desktop }}),
								calc(100vw * {{ bg_image_calc_ratio_desktop }})
							{%- endcapture -%}
          {% endif %}
        {% else %}
          {% if block.settings.image_second == blank %}
            {%- capture sizes -%}
							(min-width: 1920px) 1872px,
							calc((100vw - 24px * 2) * {{ bg_image_calc_ratio_desktop }})
						{%- endcapture -%}
          {% else %}
            {%- capture sizes -%}
							(min-width: 1920px) 936px,
							(min-width: 576px) calc(50vw - 24px * 2),
							calc((100vw - 24px * 2) * {{ bg_image_calc_ratio_desktop }})
						{%- endcapture -%}
          {% endif %}
        {% endif %}
        {% style %}
          [data-id="{{ block.id }}"].slideshow-slide {
          	--slide-height : {{ section_size }};
          }

          [data-id="{{ block.id }}"] .have-overlay {
          	--overlay-alpha : {{ block.settings.overlay_opacity }}%;
          }
        {% endstyle %}
        <div class="slideshow-swiper__slide swiper-slide">
          <div
            class="slideshow-slide{% if image_size == 'large' %} slideshow-slide_full-screen{% endif %} background color-{{ slide_color }}"
            data-id="{{ block.id }}"
            data-color-scheme="color-{{ slide_color }}"
            style="align-items: {{ vertical_alignment }}"
          >
            <div class="container  {% if section.settings.section_layout != "container" %} slideshow-slide_full-screen_text {% endif %} {% if section.settings.show_navigation or section.settings.show_pagination %}have-navigation{% endif %}">
              {% liquid
                assign show_mobile_image = false
                assign show_mobile_video = false
                assign show_main_image = false
                assign show_second_image = false
                assign show_main_video = false
                assign show_second_video = false

                if block.settings.mobile_image != blank
                  assign show_mobile_image = true
                elsif block.settings.mobile_video != blank
                  assign show_mobile_video = true
                endif

                if block.settings.image != blank
                  assign show_main_image = true
                endif

                if block.settings.image_second != blank
                  assign show_second_image = true
                endif

                if block.settings.video != blank and show_main_image == false
                  assign show_main_video = true
                endif

                if block.settings.video_second != blank and show_second_image == false
                  assign show_second_video = true
                endif
              %}
              <a
                class="slideshow-slide__img have-overlay{% if show_mobile_image or show_mobile_video %} dynamic-image {% endif %}{% if block.settings.image_second != blank or block.settings.video_second != blank %} slideshow-slide__img-multi{% endif %}"
                {% if block.settings.slide_link != blank %}
                  href="{{ block.settings.slide_link }}"
                {% endif %}
              >
                {% if show_mobile_image %}
                  {{
                    block.settings.mobile_image
                    | image_url: width: block.settings.mobile_image.width
                    | image_tag:
                      loading: 'lazy',
                      width: block.settings.mobile_image.width,
                      height: image_height,
                      sizes: '100vw',
                      widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                      class: 'mobile_image'
                  }}
                {% elsif show_mobile_video %}
                  {{
                    block.settings.mobile_video
                    | video_tag:
                      image_size: '1100x',
                      autoplay: true,
                      loop: true,
                      controls: false,
                      muted: true,
                      class: 'mobile_video'
                  }}
                {% endif %}
                {% if show_main_image %}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag:
                      loading: 'lazy',
                      width: block.settings.image.width,
                      height: image_height,
                      sizes: '100vw',
                      widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                      class: 'desktop_image'
                  }}
                {% elsif show_main_video %}
                  {{
                    block.settings.video
                    | video_tag:
                      image_size: '1100x',
                      autoplay: true,
                      loop: true,
                      controls: false,
                      muted: true,
                      class: 'desktop_video'
                  }}
                {% endif %}

                {% if show_second_image %}
                  {{
                    block.settings.image_second
                    | image_url: width: 3840
                    | image_tag:
                      loading: 'lazy',
                      width: block.settings.image_second.width,
                      height: image_height,
                      sizes: '100vw',
                      widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                      class: 'desktop_image_second'
                  }}
                {% elsif show_second_video %}
                  {{
                    block.settings.video_second
                    | video_tag:
                      image_size: '1100x',
                      autoplay: true,
                      loop: true,
                      controls: false,
                      muted: true,
                      class: 'desktop_video_second'
                  }}
                {% endif %}
              </a>

              <div class="slideshow-slide__text slideshow-slide__text-{{ alignment }}" style="{{ section_style }}">
                {% if block.settings.heading != blank %}
                  {% liquid
                    if block.settings.heading_level == 'big'
                      assign heading_tag = 'h1'
                    else
                      assign heading_tag = 'h2'
                    endif
                  %}
                  <{{ heading_tag }}
                    class="slideshow-slide__title {% if text_animation and parallax == false %} slide-up-animated{% endif %}"
                    {% if text_animation == false %}
                      data-swiper-parallax="-600"
                    {% endif %}
                  >
                    {% if text_animation %}<div class="slide-up-item">{% endif %}
                    {{ block.settings.heading }}
                    {% if text_animation %}</div>{% endif %}
                  </{{ heading_tag }}>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div
                    class="slideshow-slide__desc richtext__content large-font{% if text_animation and parallax == false %} slide-up-animated{% endif %}"
                    {% if text_animation == false %}
                      data-swiper-parallax="-800"
                    {% endif %}
                    style="{{ section_style }}"
                  >
                    {% if text_animation %}<div class="slide-up-item">{% endif %}
                    {{ block.settings.text }}
                    {% if text_animation %}</div>{% endif %}
                  </div>
                {% endif %}
                <div class="slideshow-slide__button {% if text_animation and parallax == false %} slide-up-animated{% endif %}">
                  {% render 'button', layout: block %}
                  {% render 'button',
                    btn_label: block.settings.second_button_label,
                    btn_link: block.settings.second_button_link,
                    enable_arrow: block.settings.second_button_arrow,
                    btn_style: 'simple'
                  %}
                </div>
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.show_navigation or section.settings.show_pagination %}
      <div class="swiper-controllers color-{{ section.blocks[0].settings.color_scheme }}">
        <div class="container">
          <div class="swiper-controllers__wrapper">
            {% if section.settings.show_pagination %}
              <div class="swiper-pagination small-font"></div>
            {% endif %}
            {% if section.settings.show_navigation %}
              <div class="swiper-button swiper-button-prev">
                {% render 'icon-swiper-arrow' %}
              </div>
              <div class="swiper-button swiper-button-next">
                {% render 'icon-swiper-arrow' %}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
  {% if section.settings.section_layout == 'container' %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "tag": "section",
  "class": "slideshow-section spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "select",
      "id": "section_layout",
      "default": "full",
      "label": "t:sections.all.section_layout.label",
      "options": [
        {
          "value": "full",
          "label": "t:sections.all.section_layout.options.options__1.label"
        },
        {
          "value": "container",
          "label": "t:sections.all.section_layout.options.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "section_alignment",
      "default": "left",
      "label": "t:sections.all.text.text__alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text.text__alignment.horizontal.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text.text__alignment.horizontal.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:sections.all.text.text__alignment.vertical.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text.text__alignment.vertical.options__2.label"
        },
        {
          "value": "flex-end",
          "label": "t:sections.all.text.text__alignment.vertical.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.all.text.text__alignment.vertical.label"
    },
    {
      "type": "checkbox",
      "id": "text_animation",
      "default": true,
      "label": "t:sections.all.animations.label",
      "info": "t:sections.all.animations.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.image.header.content"
    },
    {
      "type": "select",
      "id": "image_size",
      "default": "large",
      "label": "t:sections.all.image.aspect_ratio.label",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.image.aspect_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.image.aspect_ratio.options__2.label"
        },
        {
          "value": "4/3",
          "label": "t:sections.all.image.aspect_ratio.options__3.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.all.image.aspect_ratio.options__4.label"
        },
        {
          "value": "21/9",
          "label": "t:sections.all.image.aspect_ratio.options__5.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.all.image.aspect_ratio.options__6.label"
        },
        {
          "value": "large",
          "label": "t:sections.all.image.aspect_ratio.options__7.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.slider_options.header.content"
    },
    {
      "type": "checkbox",
      "id": "is_autoplay",
      "default": true,
      "label": "t:sections.all.slider_options.slider_is_autoplay.label"
    },
    {
      "type": "checkbox",
      "id": "is_hover_stop_autoplay",
      "default": false,
      "label": "t:sections.all.slider_options.slider_hover_autoplay_stop.label"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "default": true,
      "label": "t:sections.all.slider_options.navigation.label"
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "default": true,
      "label": "t:sections.all.slider_options.pagination.label"
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "default": false,
      "label": "t:sections.all.slider_options.parallax.label",
      "info": "t:sections.all.slider_options.parallax.info"
    },
    {
      "type": "range",
      "id": "slideshow_speed",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "default": 1.1,
      "unit": "s",
      "label": "t:sections.all.slider_options.speed.label"
    },
    {
      "type": "range",
      "id": "slideshow_delay",
      "min": 0,
      "max": 8,
      "step": 0.1,
      "default": 3,
      "unit": "s",
      "label": "t:sections.all.slider_options.delay.label"
    },
    {
      "type": "select",
      "id": "slide_effects",
      "options": [
        {
          "value": "slide",
          "label": "t:sections.all.slider_options.effects.options.options__1.label"
        },
        {
          "value": "fade",
          "label": "t:sections.all.slider_options.effects.options.options__2.label"
        },
        {
          "value": "coverflow",
          "label": "t:sections.all.slider_options.effects.options.options__3.label"
        },
        {
          "value": "creative",
          "label": "t:sections.all.slider_options.effects.options.options__4.label"
        },
        {
          "value": "flip",
          "label": "t:sections.all.slider_options.effects.options.options__5.label"
        }
      ],
      "default": "slide",
      "label": "t:sections.all.slider_options.effects.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "slideshow_item",
      "name": "t:sections.slideshow.blocks.name",
      "limit": 12,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "image_picker",
          "id": "image_second",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.all.mobile_image.label"
        },
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.all.video.label"
        },
        {
          "type": "video",
          "id": "video_second",
          "label": "t:sections.all.video.label"
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "t:sections.all.mobile_video.label"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "default": "background-1",
          "label": "t:sections.all.color_scheme.label"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.all.heading.label",
          "default": "t:sections.slideshow.blocks.settings.heading.default"
        },
        {
          "type": "select",
          "id": "heading_level",
          "default": "small",
          "label": "t:sections.slideshow.settings.heading_level.label",
          "options": [
            {
              "value": "big",
              "label": "t:sections.slideshow.settings.heading_level.h1"
            },
            {
              "value": "small",
              "label": "t:sections.slideshow.settings.heading_level.h2"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.text.label",
          "default": "t:sections.slideshow.blocks.settings.text.default"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "t:sections.slideshow.blocks.settings.slide_link.label"
        },
        {
          "type": "header",
          "content": "t:sections.all.button.header.content"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "t:sections.slideshow.blocks.settings.button_label.default",
          "label": "t:sections.all.button.label.label",
          "info": "t:sections.all.button.label.info"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.all.button.link.label"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.all.button.style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.all.button.style.options__2.label"
            }
          ],
          "default": "primary",
          "label": "t:sections.all.button.style.label"
        },
        {
          "type": "checkbox",
          "id": "button_arrow",
          "default": true,
          "label": "t:sections.all.button.arrow.label"
        },
        {
          "type": "header",
          "content": "t:sections.all.button.header.content_2"
        },
        {
          "type": "text",
          "id": "second_button_label",
          "default": "t:sections.slideshow.blocks.settings.second_button_label.default",
          "label": "t:sections.all.button.label.label",
          "info": "t:sections.all.button.label.info"
        },
        {
          "type": "url",
          "id": "second_button_link",
          "label": "t:sections.all.button.link.label"
        },
        {
          "type": "checkbox",
          "id": "second_button_arrow",
          "default": true,
          "label": "t:sections.all.button.arrow.label"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "default": 20,
          "unit": "%",
          "label": "t:sections.all.overlay_opacity.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.name",
      "blocks": [
        {
          "type": "slideshow_item"
        },
        {
          "type": "slideshow_item"
        },
        {
          "type": "slideshow_item"
        }
      ]
    }
  ]
}
{% endschema %}
