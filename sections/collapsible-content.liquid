{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collapsible-content.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

<link
  rel="stylesheet"
  href="{{ 'component-accordion.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

<div class="collapsible-content color-{{ section.settings.color_scheme }} background {% if section.settings.enable_border_top %} section_border_top{% endif %}{% if section.settings.enable_border_bottom %} section_border_bottom{% endif %}">
  <div class="container">
    <div class="collapsible-content-wrapper">
      <div class="collapsible-content-img-box">
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="section-header__title title--section h2">
            <span class="section-header__text">
              {{- section.settings.heading -}}
            </span>
          </{{ section.settings.heading_tag }}>
        {% endif %}
        <div class="collapsible-content__img">
          <div class="collapsible-content__img__border">
            {%- if section.settings.image != blank -%}
              {% assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio %}
              {{
                section.settings.image
                | image_url: width: 3840
                | image_tag:
                  loading: 'lazy',
                  width: section.settings.image.width,
                  height: image_height,
                  sizes: '100vw',
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
              }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="collapsible-content-box">
        {% for block in section.blocks %}
          {% if block.settings.block_heading != blank and block.settings.text != blank %}
            <div class="collapsible-content-block">
              <div class="accordion collapsible-content-item{% if block.settings.default_open %} active{% endif %}">
                <div class="collapsible-content-summery">
                  <{{ block.settings.block_heading_tag }} class="collapsible-content-block__heading h5">
                    {{ block.settings.block_heading }}
                  </{{ block.settings.block_heading_tag }}>
                  <div>{% render 'icon-caret' %}</div>
                </div>
                {%- if block.settings.text != blank -%}
                  <div
                    class="collapsible-content-block__description medium-font richtext__content"
                    {% if block.settings.default_open != true %}
                      style="display: none"
                    {% endif %}
                  >
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.collapsible-content.name",
  "class": "collapsible-content-section",
  "tag": "section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.collapsible-content.settings.heading.default",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        },
        {
          "value": "p",
          "label": "t:sections.all.heading_tag.options__8.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "t:sections.all.image.header.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "xs",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        }
      ],
      "default": "xs",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "default": true,
      "label": "t:sections.all.border.border_enable_top.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_bottom",
      "default": true,
      "label": "t:sections.all.border.border_enable_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "text-block",
      "name": "t:sections.collapsible-content.blocks.accordion.name",
      "settings": [
        {
          "type": "checkbox",
          "id": "default_open",
          "default": false,
          "label": "t:sections.collapsible-content.blocks.accordion.settings.default_open.label"
        },
        {
          "type": "inline_richtext",
          "id": "block_heading",
          "default": "t:sections.collapsible-content.blocks.accordion.settings.block_heading.default",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "select",
          "id": "block_heading_tag",
          "options": [
            {
              "value": "h1",
              "label": "t:sections.all.heading_tag.options__1.label"
            },
            {
              "value": "h2",
              "label": "t:sections.all.heading_tag.options__2.label"
            },
            {
              "value": "h3",
              "label": "t:sections.all.heading_tag.options__3.label"
            },
            {
              "value": "h4",
              "label": "t:sections.all.heading_tag.options__4.label"
            },
            {
              "value": "h5",
              "label": "t:sections.all.heading_tag.options__5.label"
            },
            {
              "value": "h6",
              "label": "t:sections.all.heading_tag.options__6.label"
            },
            {
              "value": "div",
              "label": "t:sections.all.heading_tag.options__7.label"
            },
            {
              "value": "p",
              "label": "t:sections.all.heading_tag.options__8.label"
            }
          ],
          "default": "h2",
          "label": "t:sections.all.heading_tag.label",
          "info": "t:sections.all.heading_tag.info",
          "visible_if": "{{ block.settings.block_heading != blank }}"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.collapsible-content.blocks.accordion.settings.text.default",
          "label": "t:sections.all.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collapsible-content.name",
      "blocks": [
        {
          "type": "text-block",
          "settings": {
            "default_open": true
          }
        },
        {
          "type": "text-block"
        },
        {
          "type": "text-block"
        },
        {
          "type": "text-block"
        }
      ]
    }
  ]
}
{% endschema %}
