<a
  href="{{ menu_link }}"
  class="unstyled-link header__menu-item {{ menu_link_class }}{% if link.current %} current-link{% endif %}"
  {% if link.current %}
    aria-current="page"
  {% endif %}
>
  {{- link.title | escape }}
</a>

<div class="header__mega-submenu mega-submenu" {{ block.shopify_attributes }}>
  <div class="container">
    <div class="mega-submenu__wrapper" tabindex="-1" role="dialog">
      <div class="mega-submenu__wrapper-inner">
        {%- assign first_tab_id = link.links.first.title | escape | handle | append: '-' | append: 0 -%}

        <div class="mega-submenu__tabs">
          {%- for sublink in link.links -%}
            {%- assign current_tab_id = sublink.title | escape | handle | append: '-' | append: forloop.index0 -%}
            <div class="mega-submenu-item" data-hover-opacity="5">
              {%- if block.settings.enable_clickable_top_level -%}
                <a
                  href="{{ sublink.url }}"
                  class="mega-submenu__tab header-mega-menu__link list-menu-item-animate large-font focus-inset{% if current_tab_id == first_tab_id %} active{% endif %}"
                  data-tab-id="{{ current_tab_id }}"
                >
                  <span class="header__submenu-item">{{- sublink.title | escape -}}</span>
                </a>
              {%- else -%}
                <span
                  class="mega-submenu__tab header-mega-menu__link large-font list-menu-item-animate{% if current_tab_id == first_tab_id %} active{% endif %}"
                  data-tab-id="{{ current_tab_id }}"
                >
                  <span class="header__submenu-item">{{- sublink.title | escape -}}</span>
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- for sublink in link.links -%}
          {%- if sublink.links != blank -%}
            {%- assign current_tab_id = sublink.title | escape | handle | append: '-' | append: forloop.index0 -%}
            <div
              class="mega-submenu__submenu{% if current_tab_id == first_tab_id %} active{% endif %}"
              data-tab-id="{{ current_tab_id }}"
              data-hover-opacity="5"
            >
              {%- for subsublink in sublink.links -%}
                <div class="mega-submenu__submenu-item" data-hover-opacity="2">
                  <a
                    href="{{ subsublink.url }}"
                    class="list-menu-item-animate body-small focus-inset"
                  >
                    <span class="header__submenu-item">{{- subsublink.title | escape -}}</span>
                  </a>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>
