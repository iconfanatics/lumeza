{%- if shop.customer_accounts_enabled and section.settings.enable_account_btn -%}
  {% if in_header_drawer %}
    {%- if customer -%}
      <div class="menu-drawer__utility-account">
        <div class="menu-drawer__utility-account-header">
          <a
            href="{{ routes.account_profile_url }}"
            class="menu-drawer__utility-name"
          >
            {% if section.settings.account_modal_type == 'shopify_based' %}
              <shopify-account
                menu="{{ section.settings.customer_account_menu | default: "customer-account-main-menu" }}"
                style="display: flex; align-items: center;"
              >
                <div slot="signed-out-avatar">
                  <div class="header__button header__button--{{ button_type }} header__button--account button button--simple">
                    <div class="button__content">
                      <span
                        class="button__label header-label "
                        data-label="{{- 'customer.log_in' | t -}}"
                      >
                        {%- liquid
                          if customer
                            echo 'customer.account_fallback' | t
                          else
                            echo 'customer.log_in' | t
                          endif
                        -%}
                      </span>
                    </div>
                  </div>
                </div>
              </shopify-account>
            {% else %}
              <span>{{ customer.name }}</span>
            {% endif %}
          </a>
          <a
            class="menu-drawer__utility-logout"
            href="{{ routes.account_logout_url }}"
          >
            {{- 'customer.log_out' | t -}}
          </a>
        </div>
      </div>
    {%- else -%}
      {% if section.settings.account_modal_type == 'shopify_based' %}
        <shopify-account
          menu="{{ section.settings.customer_account_menu | default: "customer-account-main-menu" }}"
          style="display: flex; align-items: center;"
        >
          <div slot="signed-out-avatar">
            <div class="header__button header__button--{{ button_type }} header__button--account button button--primary menu-drawer__account focus-inset">
              <div class="button__content">
                <span
                  class="button__label header-label "
                  data-label="{{- 'customer.log_in' | t -}}"
                >
                  {%- liquid
                    if customer
                      echo 'customer.account_fallback' | t
                    else
                      echo 'customer.log_in' | t
                    endif
                  -%}
                </span>
              </div>
            </div>
          </div>
        </shopify-account>
      {% else %}
        <a
          href="{%- if customer -%}{{ routes.account_profile_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
          class="button button--primary menu-drawer__account focus-inset"
        >
          <span class="button-label">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {% endif %}
    {% endif %}
  {% elsif in_buger_menu %}
    {% if section.settings.account_modal_type == 'shopify_based' %}
      <shopify-account
        menu="{{ section.settings.customer_account_menu | default: "customer-account-main-menu" }}"
        style="display: flex; align-items: center; justify-content: flex-end;"
      >
        <div slot="signed-out-avatar">
          <div class="header__button header__button--{{ button_type }} header__button--account button button--simple">
            <div class="button__content">
              <span
                class="button__label header-label "
                data-label="{{- 'customer.log_in' | t -}}"
              >
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </span>
            </div>
          </div>
        </div>
      </shopify-account>
    {% else %}
      {%- if customer -%}
        <div class="menu-drawer__utility-account">
          <div class="menu-drawer__utility-account-header">
            <a
              href="{{ routes.account_profile_url }}"
              class="menu-drawer__utility-name"
            >
              <span>{{ customer.name }}</span>
            </a>
            <a
              class="menu-drawer__utility-logout"
              href="{{ routes.account_logout_url }}"
            >
              {{- 'customer.log_out' | t -}}
            </a>
          </div>
        </div>
      {%- else -%}
        <div class="burger_account_log_in">
          <div class="medium-font">
            {{ block.settings.description }}
          </div>
          <a
            href="{%- if customer -%}{{ routes.account_profile_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="button button--primary menu-drawer__account focus-inset"
          >
            <span class="button-label">
              {%- liquid
                if customer
                  echo 'customer.account_fallback' | t
                else
                  echo 'customer.log_in' | t
                endif
              -%}
            </span>
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  {% else %}
    <details-disclosure class="header__account">
      {% if section.settings.account_modal_type == 'shopify_based' %}
        <shopify-account
          menu="{{ section.settings.customer_account_menu | default: "customer-account-main-menu" }}"
          style="display: flex; align-items: center;"
        >
          <div slot="signed-out-avatar">
            <div class="header__icon header__icon--account header__icon--summary focus-inset modal__toggle">
              {% render 'icon-account' %}
            </div>
          </div>
        </shopify-account>
      {%- else -%}
        <details>
          <summary
            class="header__icon header__icon--account header__icon--summary focus-inset modal__toggle"
            aria-haspopup="dialog"
            role="button"
          >
            {% render 'icon-account' %}
            {% comment %}<span class="header__icon-name" title="{{ 'customer.account.title' | t }}">{{ 'customer.account.title' | t }}</span>{% endcomment %}
          </summary>
          <div
            class="header__account-modal modal__toggle color-background-1"
            role="dialog"
            aria-modal="true"
          >
            {%- if customer -%}
              <div class="header__account__account">
                <div class="header__account__name h6">{{ customer.name }}</div>
                <ul class="header__account__body list-unstyled">
                  <li class="header__account__link">
                    <a href="{{ routes.account_profile_url }}">
                      {{ 'customer.account.title' | t }}
                    </a>
                  </li>
                </ul>
                <a
                  class="header__account__logout button button--primary"
                  href="{{ routes.account_logout_url }}"
                >
                  <span class="button-label">
                    <span>{{ 'customer.log_out' | t }}</span>
                  </span>
                </a>
              </div>
            {%- else -%}
              <a
                href="{%- if customer -%}{{ routes.account_profile_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="button button--primary header__account__login focus-inset"
              >
                <span class="button-label">
                  {%- liquid
                    if customer
                      echo 'customer.account_fallback' | t
                    else
                      echo 'customer.log_in' | t
                    endif
                  -%}
                </span>
              </a>
            {%- endif -%}
          </div>
        </details>
      {%- endif -%}
    </details-disclosure>
  {%- endif -%}
{%- endif -%}
